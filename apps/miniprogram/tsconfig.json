{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "@web/*": ["../../src/*"] },
    "types": ["@tarojs/taro", "@tarojs/components"]
  },
  "include": ["src", "config", "test"]
}
